# Images with the toolchain preinstalled.
#
# Every job otherwise spent 26-55s running the same pacman transaction, up
# to half its total runtime. Baking the packages in moves that cost to a
# weekly image build.
#
# repo-add and makepkg have to come from the same pacman generation that
# produced the packages, or the database rejects them as "not a package
# file". Both bases below ship pacman 7.1.0.r9.g54d9411-2, so that holds
# across the per-architecture split.

# declared before the first FROM: an ARG after one is scoped to that
# stage, and a later FROM expands it to nothing
ARG BUILDER_BASE=manjarolinux/base:latest

FROM manjarolinux/base:latest AS repo
# publish, promote and remove: rewrite the database and talk to R2
RUN pacman -Syu --noconfirm --needed \
      pacman-contrib python python-boto3 python-yaml gnupg && \
    pacman -Scc --noconfirm
# the signing key lands here at run time; pre-create it so gpg does not
# have to fix up permissions on every job
RUN install -dm700 /root/.gnupg

# The builder base differs per architecture, and BUILDER_BASE selects it -
# build-images.yml passes the one that matches the architecture it is
# building on.
#
# Manjaro's ARM branches are years behind its x86 ones: arm-stable ships
# gcc 12.1.0, glibc 2.35 and rust 1.76, against 16.2.1, 2.44 and 1.98.1 on
# x86. Old enough that four packages failed on aarch64 alone while the
# same versions built cleanly on x86_64 (#50) - two on a Cargo lockfile v4
# that needs cargo 1.78, one on a libalpm generation mismatch in cgo, one
# on gcc rejecting `!va_list`. Even arm-unstable only reaches rust 1.89.
#
# Arch Linux ARM tracks Arch closely - gcc 16.1.1, glibc 2.43, rust 1.98.1,
# the same rust Manjaro x86 ships - so aarch64 builds there instead.
FROM ${BUILDER_BASE} AS builder
# Arch Linux ARM's pacman.conf sets DownloadUser = alpm; Manjaro's sets
# none. pacman then drops to that user behind a Landlock ruleset, which
# neither buildkit nor the job container will let it apply:
#
#   error: restricting filesystem access failed because the Landlock
#     ruleset could not be applied: Operation not permitted
#   error: switching to sandbox user 'alpm' failed!
#
# Dropping the setting here fixes the image build and every pacman and
# makepkg call in the jobs that use the image, which --disable-sandbox on
# this one transaction did not. It costs nothing: the container is
# unprivileged and thrown away, and packages are still signature-checked.
RUN sed -i 's/^DownloadUser/#DownloadUser/' /etc/pacman.conf && \
    pacman -Syu --noconfirm --needed \
      base-devel git sudo python gnupg curl && \
    pacman -Scc --noconfirm && \
    (id -u builder >/dev/null 2>&1 || useradd -m builder) && \
    echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder && \
    install -dm700 -o builder -g builder /home/builder/.gnupg
